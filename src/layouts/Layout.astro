---
import { Font } from "astro:assets";
import "@/styles/global.scss";
import Navbar from "@/components/Global/Navbar.astro";
import Footer from "@/components/Global/Footer.astro";
import { getCollection } from "astro:content";
import { gammesAffichees } from "@/lib/gammes";

type Props = {
  titre: string;
  description: string;
};

const { titre, description } = Astro.props;

const gammes = gammesAffichees(await getCollection("gammes"));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{titre}</title>
    <meta name="description" content={description} />

    <Font cssVariable="--font-title" preload />
    <Font cssVariable="--font-text" preload />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer gammes={gammes} />
  </body>
</html>
