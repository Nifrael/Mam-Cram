---
import { Font } from "astro:assets";
import "@/styles/global.scss";
import SEO from "@/components/Global/SEO.astro";
import Navbar from "@/components/Global/Navbar.astro";
import Footer from "@/components/Global/Footer.astro";
import { getCollection } from "astro:content";
import { gammesAffichees } from "@/lib/gammes";
import type { JsonLd } from "@/lib/donnees-structurees";

type Props = {
  titre: string;
  description: string;
  indexable?: boolean;
  type?: "website" | "article";
  image?: { src: ImageMetadata; alt: string };
  donneesStructurees?: JsonLd;
};

const { titre, description, indexable = true, type, image, donneesStructurees } = Astro.props;

const gammes = gammesAffichees(await getCollection("gammes"));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEO titre={titre} description={description} indexable={indexable} type={type}
      image={image} donneesStructurees={donneesStructurees} />

    <Font cssVariable="--font-title" preload />
    <Font cssVariable="--font-text" preload />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer gammes={gammes} />
  </body>
</html>
