---
import Layout from "@/layouts/Layout.astro";
import EnTetePage from "@/components/UI/EnTetePage.astro";

const titre = "L'art du fil et de l'onde,";
const accent = "façonné par les marées.";
const intro =
  "Au cœur des PO, MAM'CRAM est né d'une rencontre entre la patience infinie du tissage à la main et la beauté brute du bois flotté échoué sur nos grèves bretonnes.";
---

<Layout
  titre="Notre histoire — MAM'CRAM"
  description="L'histoire de MAM'CRAM : Jean-Luc et Christelle, un atelier de macramé et de bois flotté né sur les grèves des Côtes-d'Armor."
>
  <main class="container">
    <EnTetePage titre={titre} accent={accent} intro={intro} />
  </main>
</Layout>
