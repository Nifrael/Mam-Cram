---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import EnTetePage from "@/components/UI/EnTetePage.astro";

const page = await getEntry("histoire", "notre-histoire");
// Fichier Markdown supprimé ou renommé : le build s'arrête avec un message clair.
if (!page) throw new Error("src/content/histoire/notre-histoire.md est introuvable.");

const { titre, accent, intro, description } = page.data;
// `render` transforme le corps Markdown en composant affichable.
const { Content } = await render(page);
---

<Layout titre="Notre histoire, atelier de macramé et bois flotté — MAM'CRAM" description={description}>
  <main class="container">
    <EnTetePage titre={titre} accent={accent} intro={intro} />

    <div class="texte">
      <Content />
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  // Structure seulement : la mise en forme attend la maquette validée.
  // Le HTML du Markdown n'a pas les classes du composant : :global() est
  // nécessaire pour l'atteindre, limité aux éléments sous .texte.
  .texte {
    display: grid;
    gap: var(--espace-m);
    max-width: 50rem;
    padding-block-end: var(--espace-xl);

    :global(h2) {
      font-size: var(--h3);
    }

    :global(* + h2) {
      margin-block-start: var(--espace-m);
    }

    :global(p) {
      color: var(--color-text-secondary);
    }

    // Photos carrées : pleine largeur sur mobile, la moitié de la colonne au-delà
    // pour qu'une seule photo ne prenne pas tout l'écran.
    :global(img) {
      display: block;
      width: 100%;
      height: auto;
      border-radius: var(--rayon-m);

      @include breakpoint-up($breakpoint-tablet) {
        width: 50%;
      }
    }

    // Photos écrites sur des lignes qui se suivent dans le Markdown : elles tombent dans
    // le même paragraphe, affiché côte à côte, sur toutes les largeurs.
    // aspect-ratio + object-fit recadrent chaque photo en carré pour que la rangée
    // reste alignée même si une photo est en paysage.
    :global(p:has(> img + img)) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: var(--espace-s);

      :global(img) {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
      }

      // La première photo garde son bord gauche, le recadrage mange la droite.
      :global(img:first-child) {
        object-position: left;
      }
    }
  }
</style>
