---
import Layout from "@/layouts/Layout.astro";
import LienFleche from "@/components/UI/LienFleche.astro";

// [À VALIDER]
const titre = "Page introuvable";
const texte =
  "Cette page n'existe pas ou a changé d'adresse. Reprenez le fil depuis l'accueil, ou découvrez nos créations.";
---

<Layout
  titre="Page introuvable — MAM'CRAM"
  description="La page demandée n'existe pas sur le site de MAM'CRAM."
  indexable={false}
>
  <main class="introuvable container">
    <h1>{titre}</h1>
    <p class="texte">{texte}</p>
    <LienFleche href="/">Retour à l'accueil</LienFleche>
    <LienFleche href="/creations/">Découvrir nos créations</LienFleche>
  </main>
</Layout>

<style lang="scss">
  .introuvable {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--espace-m);
    min-height: calc(100dvh - var(--hauteur-entete));
    padding-block: var(--espace-xl);
    text-align: center;
  }

  .texte {
    max-width: 55ch;
    color: var(--color-text-secondary);
  }
</style>
