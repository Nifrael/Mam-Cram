---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import EnTetePage from "@/components/UI/EnTetePage.astro";
import BoutiqueLeBonCoin from "@/components/UI/BoutiqueLeBonCoin.astro";
import AppelSurMesure from "@/components/UI/AppelSurMesure.astro";
import CarteObjet from "@/components/Creations/CarteObjet.astro";
import AutresGammes from "@/components/Creations/AutresGammes.astro";
import FilAriane from "@/components/UI/FilAriane.astro";
import LienFleche from "@/components/UI/LienFleche.astro";
import { reseaux } from "@/data/coordonnees";
import { gammesAffichees } from "@/lib/gammes";
import { objetsDeLaGamme } from "@/lib/objets";

export const getStaticPaths = (async () => {
  const gammes = gammesAffichees(await getCollection("gammes"));
  const objets = await getCollection("objets");

  return gammes.map((gamme) => ({
    params: { slug: gamme.id },
    props: {
      gamme,
      objets: objetsDeLaGamme(objets, gamme.id),
      autresGammes: gammes.filter((autre) => autre.id !== gamme.id),
    },
  }));
}) satisfies GetStaticPaths;

type Props = {
  gamme: CollectionEntry<"gammes">;
  objets: CollectionEntry<"objets">[];
  autresGammes: CollectionEntry<"gammes">[];
};

const { gamme, objets, autresGammes } = Astro.props;
const { titre, description, photo } = gamme.data;
---

<Layout titre={`${titre} en macramé et bois flotté — MAM'CRAM`} description={description} image={photo}>
  <main class="container">
    <FilAriane parent={{ href: "/creations/", texte: "Nos créations" }} courant={titre} />

    <EnTetePage surtitre="Pièces uniques, faites main" titre={titre} intro={description}>
      <LienFleche href={reseaux.leboncoin.url} externe slot="action">
        Voir les pièces disponibles sur Le Bon Coin
      </LienFleche>
    </EnTetePage>

    {
      objets.length > 0 ? (
        <ul class="grille">
          {objets.map((objet) => (
            <li>
              <CarteObjet objet={objet} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="vide">De nouvelles pièces arrivent bientôt dans cette gamme.</p>
      )
    }

    <div class="autres">
      <AutresGammes gammes={autresGammes} />
    </div>

    <div class="boutique">
      <BoutiqueLeBonCoin />
    </div>

    <div class="sur-mesure">
      <AppelSurMesure />
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .grille {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--espace-l) var(--espace-m);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--espace-xl) var(--espace-l);
    }

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .vide {
    color: var(--color-text-secondary);
    text-align: center;
  }

  .autres {
    padding-block-start: var(--espace-xl);
  }

  .boutique {
    padding-block-start: var(--espace-xl);
  }

  .sur-mesure {
    padding-block: var(--espace-xl);
  }
</style>
