---
import Layout from "@/layouts/Layout.astro";
import BlocGamme from "@/components/Creations/BlocGamme.astro";
import EnTetePage from "@/components/UI/EnTetePage.astro";
import AppelSurMesure from "@/components/UI/AppelSurMesure.astro";
import { getCollection } from "astro:content";
import { gammesAffichees } from "@/lib/gammes";

const gammes = gammesAffichees(await getCollection("gammes"));

const titre = "Nos créations,";
const accent = "nouées à la main.";
const intro =
  "Trois familles de pièces, toutes nouées à la main dans notre atelier, du petit cadeau de naissance à la grande tenture.";
---

<Layout
  titre="Nos créations — MAM'CRAM"
  description="Les trois gammes de MAM'CRAM : petites douceurs, accessoires du quotidien et pièces maîtresses en macramé et bois flotté, faites main."
>
  <main class="container">
    <EnTetePage titre={titre} accent={accent} intro={intro} />

    <ul class="liste">
      {
        gammes.map((gamme, index) => (
          <li>
            <BlocGamme gamme={gamme} index={index} />
          </li>
        ))
      }
    </ul>

    <div class="sur-mesure">
      <AppelSurMesure />
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .liste {
    list-style: none;
  }

  li {
    padding-block: var(--espace-l);

    & + li {
      border-top: 1px solid var(--color-border);
    }

    @include breakpoint-up($breakpoint-tablet) {
      padding-block: var(--espace-xl);
    }
  }

  .sur-mesure {
    padding-block-end: var(--espace-xl);
  }
</style>
