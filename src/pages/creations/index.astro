---
import Layout from "@/layouts/Layout.astro";
import CarteGamme from "@/components/Creations/CarteGamme.astro";
import EnTetePage from "@/components/UI/EnTetePage.astro";
import BoutiqueLeBonCoin from "@/components/UI/BoutiqueLeBonCoin.astro";
import AppelSurMesure from "@/components/UI/AppelSurMesure.astro";
import LienFleche from "@/components/UI/LienFleche.astro";
import { reseaux } from "@/data/coordonnees";
import { getCollection } from "astro:content";
import { gammesAffichees } from "@/lib/gammes";

const gammes = gammesAffichees(await getCollection("gammes"));

const titre = "Nos créations,";
const accent = "nouées à la main.";
const intro =
  "Du petit cadeau de naissance à la grande tenture, toutes nos pièces sont nouées à la main dans notre atelier. Au fil des saisons, de nouvelles gammes viennent compléter la collection.";
---

<Layout
  titre="Nos créations en macramé et bois flotté — MAM'CRAM"
  description="Toutes les gammes de MAM'CRAM : petites douceurs, accessoires du quotidien, pièces maîtresses et créations de saison en macramé et bois flotté, faites main."
>
  <main class="container">
    <EnTetePage surtitre="Pièces uniques, faites main" titre={titre} accent={accent} intro={intro}>
      <LienFleche href={reseaux.leboncoin.url} externe slot="action">
        Voir les pièces disponibles sur Le Bon Coin
      </LienFleche>
    </EnTetePage>

    <ul class="liste">
      {
        gammes.map((gamme) => (
          <li>
            <CarteGamme gamme={gamme} niveauTitre={2} />
          </li>
        ))
      }
    </ul>

    <div class="boutique">
      <BoutiqueLeBonCoin />
    </div>

    <div class="sur-mesure">
      <AppelSurMesure />
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  // Même grille que les gammes de l'accueil : 1, 2 puis 3 colonnes.
  .liste {
    list-style: none;
    display: grid;
    gap: var(--espace-m);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(2, 1fr);
    }

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--espace-l);
    }
  }

  .boutique {
    padding-block: var(--espace-xl) var(--espace-l);
  }

  .sur-mesure {
    padding-block-end: var(--espace-xl);
  }
</style>
