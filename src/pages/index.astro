---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { gammesAffichees } from "@/lib/gammes";
import { actualitesParDate } from "@/lib/actualites";
import { entreprise, siteWeb, graphe } from "@/lib/donnees-structurees";
import { nomDuSite } from "@/data/seo";
import { email, listeReseaux } from "@/data/coordonnees";
import Hero from "@/components/Home/Hero.astro";
import GammesList from "@/components/Home/GammesList.astro";
import Personnalisation from "@/components/Home/Personnalisation.astro";
import Histoire from "@/components/Home/Histoire.astro";
import Actualites from "@/components/Home/Actualites.astro";

const gammes = gammesAffichees(await getCollection("gammes"));
// Les trois plus récentes seulement ; les autres sont sur la page Actualités.
const actualites = actualitesParDate(await getCollection("actualites")).slice(0, 3);

const description =
  "Créations artisanales en macramé, bois flotté et matériaux naturels. Pièces uniques faites main, personnalisables sur commande.";

// `site` (URL_SITE) est obligatoire au build : voir le schéma d'environnement.
const urlSite = new URL("/", Astro.site);

// Description de l'entreprise pour les moteurs de recherche, avec ses réseaux.
// Valeurs de coordonnees.ts : à remplacer par les vraies avant de passer INDEXATION à true.
const donneesStructurees = graphe(
  entreprise({
    nom: nomDuSite,
    url: urlSite,
    description,
    email,
    reseaux: listeReseaux.map((reseau) => reseau.url),
  }),
  siteWeb({ nom: nomDuSite, url: urlSite }),
);
---

<Layout
  titre="MAM'CRAM — Créations en macramé et bois flotté"
  description={description}
  donneesStructurees={donneesStructurees}
>
  <main>
    <Hero />
    <GammesList gammes={gammes} />
    <Personnalisation />
    <Histoire />
    {actualites.length > 0 && <Actualites actualites={actualites} />}
  </main>
</Layout>
