---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { gammesAffichees } from "@/lib/gammes";
import Hero from "@/components/Home/Hero.astro";
import GammesList from "@/components/Home/GammesList.astro";
import Personnalisation from "@/components/Home/Personnalisation.astro";
import Histoire from "@/components/Home/Histoire.astro";
import Actualites from "@/components/Home/Actualites.astro";

const gammes = gammesAffichees(await getCollection("gammes"));
---

<Layout
  titre="MAM'CRAM — Créations en macramé et bois flotté"
  description="Créations artisanales en macramé, bois flotté et matériaux naturels. Pièces uniques faites main, personnalisables sur commande."
>
  <main>
    <Hero />
    <GammesList gammes={gammes} />
    <Personnalisation />
    <Histoire />
    <Actualites />
  </main>
</Layout>
