---
import Icone from "@/components/UI/Icone.astro";

type Props = {
  titre: string;
  accent?: string;
  intro: string;
};

const { titre, accent, intro } = Astro.props;
---

<header class="en-tete">
  <div class="bloc">
    <h1>
      {titre}
      {accent && <> <span class="accent">{accent}</span></>}
    </h1>
    <p class="intro">{intro}</p>
  </div>

  {/* Deux éléments, deux animations : le span s'efface au scroll, l'icône rebondit. */}
  <span class="fleche">
    <Icone nom="fleche-bas" />
  </span>
</header>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .en-tete {
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    justify-items: center;
    min-height: calc(100dvh - var(--hauteur-entete));
    padding-block: var(--espace-xl) var(--espace-l);
    text-align: center;
  }

  .bloc {
    display: grid;
    gap: var(--espace-s);
    justify-items: center;
  }

  .accent {
    display: block;
    color: var(--color-accent);
    font-style: italic;
  }

  .intro {
    max-width: 55ch;
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }

  .fleche > :global(.icone) {
    inline-size: 1.5em;
    block-size: 1.5em;
    color: var(--color-text-secondary);
    stroke-width: 1.5;
    opacity: 50%;
    animation: rebond 1.6s ease-in-out 1s 3;
  }

  @keyframes rebond {
    50% {
      transform: translateY(var(--espace-s));
    }
  }

  @keyframes disparition {
    to {
      opacity: 0;
    }
  }

  // Fondu lié au scroll, écrit en propriétés détaillées et jamais avec le
  // raccourci `animation` : au build, le minifieur fusionnait `animation` et
  // `animation-timeline` en une seule déclaration que les navigateurs rejettent
  // (animation-timeline n'est pas autorisé dans le raccourci).
  @supports (animation-timeline: scroll()) {
    .fleche {
      animation-name: disparition;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll();
      animation-range: 0 var(--espace-xl);
    }
  }

  // Moins d'animations demandé : plus de rebond. Le fondu au scroll reste,
  // il ne fait rien bouger.
  @media (prefers-reduced-motion: reduce) {
    .fleche > :global(.icone) {
      animation: none;
    }
  }
</style>
