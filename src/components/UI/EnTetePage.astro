---
import Icone from "@/components/UI/Icone.astro";

type Props = {
  titre: string;
  accent?: string;
  intro: string;
};

const { titre, accent, intro } = Astro.props;
---

<header class="en-tete">
  <div class="bloc">
    <h1>
      {titre}
      {accent && <> <span class="accent">{accent}</span></>}
    </h1>
    <p class="intro">{intro}</p>
  </div>

  <Icone nom="fleche-bas" />
</header>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .en-tete {
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    justify-items: center;
    min-height: calc(100dvh - var(--hauteur-entete));
    padding-block: var(--espace-xl) var(--espace-l);
    text-align: center;
  }

  .bloc {
    display: grid;
    gap: var(--espace-s);
    justify-items: center;
  }

  .accent {
    display: block;
    color: var(--color-accent);
    font-style: italic;
  }

  .intro {
    max-width: 55ch;
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }

  .en-tete > :global(.icone) {
    inline-size: 1.5em;
    block-size: 1.5em;
    color: var(--color-text-secondary);
    stroke-width: 1.5;
    animation: rebond 1.6s ease-in-out 1s 3;
    opacity: 50%;
  }

  @keyframes rebond {
    50% {
      transform: translateY(var(--espace-s));
    }
  }

  @keyframes disparition {
    to {
      opacity: 0;
    }
  }

  @supports (animation-timeline: scroll()) {
    .en-tete > :global(.icone) {
      animation:
        rebond 1.6s ease-in-out 1s 3,
        disparition linear both;
    }

    .en-tete > :global(.icone) {
      animation-timeline: auto, scroll();
      animation-range: normal, 0 var(--espace-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .en-tete > :global(.icone) {
      animation: none;
    }

    @supports (animation-timeline: scroll()) {
      .en-tete > :global(.icone) {
        animation: disparition linear both;
      }

      .en-tete > :global(.icone) {
        animation-timeline: scroll();
        animation-range: 0 var(--espace-xl);
      }
    }
  }
</style>
