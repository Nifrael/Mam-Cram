---
type Props = {
  titre: string;
  accent?: string;
  intro: string;
};

const { titre, accent, intro } = Astro.props;
---

<header class="en-tete">
  <h1>
    {titre}
    {accent && <> <span class="accent">{accent}</span></>}
  </h1>
  <p class="intro">{intro}</p>
  <slot />
</header>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  // En-tête compact : le contenu de la page (photos, formulaire…) doit
  // apparaître dès le premier écran, surtout sur téléphone.
  .en-tete {
    display: grid;
    gap: var(--espace-s);
    justify-items: center;
    padding-block: var(--espace-l);
    text-align: center;

    @include breakpoint-up($breakpoint-tablet) {
      gap: var(--espace-m);
      padding-block: var(--espace-xl) var(--espace-l);
    }
  }

  // Taille --h2 sur mobile pour que les titres longs (page Contact) ne
  // remplissent pas l'écran, --h1 à partir de la tablette.
  h1 {
    font-size: var(--h2);

    @include breakpoint-up($breakpoint-tablet) {
      font-size: var(--h1);
    }
  }

  .accent {
    display: block;
    color: var(--color-accent);
    font-style: italic;
  }

  .intro {
    max-width: 55ch;
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }
</style>
