---
import { filAriane, graphe, versJsonLd } from "@/lib/donnees-structurees";

type Props = {
  parent: { href: string; texte: string };
  courant: string;
};

const { parent, courant } = Astro.props;

// Le fil d'Ariane décrit la même chose pour les moteurs de recherche : les données
// sont déjà ici, on les réutilise plutôt que de les redire dans chaque page.
const donneesStructurees = graphe(
  filAriane({
    parent: { nom: parent.texte, url: new URL(parent.href, Astro.site) },
    courant: { nom: courant, url: new URL(Astro.url.pathname, Astro.site) },
  }),
);
---

<script type="application/ld+json" set:html={versJsonLd(donneesStructurees)} />

<nav class="fil-ariane" aria-label="Fil d'Ariane">
  <ol>
    <li><a href={parent.href}>{parent.texte}</a></li>
    <li aria-current="page">{courant}</li>
  </ol>
</nav>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .fil-ariane {
    padding-block-start: var(--espace-m);
    font-size: var(--little-text);

    ol {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: var(--espace-s);
    }

    li {
      color: var(--color-text-secondary);
    }

    li + li::before {
      content: "/";
      margin-inline-end: var(--espace-s);
    }

    a {
      text-decoration: none;

      @include breakpoint-up($breakpoint-desktop) {
        &:hover {
          color: var(--color-accent);
        }
      }
    }
  }
</style>
