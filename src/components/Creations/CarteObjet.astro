---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = { objet: CollectionEntry<"objets"> };

const { objet } = Astro.props;
const { titre, resume, personnalisable } = objet.data;
const [photo] = objet.data.photos;
---

<article class="carte">
  <div class="visuel">
    <Image class="photo" src={photo.src} alt={photo.alt} sizes="(min-width: 1152px) 24rem, (min-width: 768px) 33vw, 50vw" />
    {personnalisable && <p class="badge">Personnalisable</p>}
  </div>
  <h2 class="titre">{titre}</h2>
  <p class="resume">{resume}</p>
</article>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .carte {
    display: grid;
    align-content: start;
    gap: var(--espace-xs);
  }

  .visuel {
    position: relative;
    margin-block-end: var(--espace-xs);
  }

  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--rayon-m);
  }

  // Même pastille que sur les cartes de gamme.
  .badge {
    position: absolute;
    inset-block-start: var(--espace-s);
    inset-inline-start: var(--espace-s);
    padding: var(--espace-xs) var(--espace-s);
    background: var(--color-bg-cards);
    color: var(--color-accent);
    border-radius: var(--rayon-m);
    font-size: var(--little-text);
  }

  .titre {
    font-size: var(--h5);
  }

  .resume {
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }
</style>
