---
import { Image } from "astro:assets";
import LienFleche from "@/components/UI/LienFleche.astro";
import type { Gamme } from "@/data/gammes";

type Props = {
  gamme: Gamme;
  index: number;
};

const { gamme, index } = Astro.props;
const inverse = index % 2 === 1;
---

<article class:list={["bloc", { "bloc--inverse": inverse }]}>
  <Image
    class="photo"
    src={gamme.photo}
    alt={gamme.altPhoto}
    loading={index === 0 ? "eager" : "lazy"}
  />

  <div class="texte">
    <h2>{gamme.titre}</h2>
    <p class="description">{gamme.description}</p>
    <LienFleche href={`/creations/${gamme.slug}/`}>
      Voir les créations <span class="visually-hidden">{gamme.titre}</span>
    </LienFleche>
  </div>
</article>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .bloc {
    display: grid;
    gap: var(--espace-m);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--espace-xl);
    }
  }

  // Un bloc sur deux, la photo passe à droite. L'ordre de lecture
  // (photo puis texte) ne change pas pour les lecteurs d'écran.
  .bloc--inverse .photo {
    @include breakpoint-up($breakpoint-tablet) {
      order: 1;
    }
  }

  .photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--rayon-m);
  }

  .texte {
    display: grid;
    gap: var(--espace-m);
    justify-items: start;
  }

  .description {
    max-width: 45ch;
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }
</style>
