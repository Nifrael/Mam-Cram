---
import { email, telephone, reseaux } from "@/data/coordonnees";
import type { CollectionEntry } from "astro:content";
import Icone, { type NomIcone } from "@/components/UI/Icone.astro";

type Props = { gammes: CollectionEntry<"gammes">[] };

const { gammes } = Astro.props;

const slogan = "Atelier d'artisanat d'art";
const presentation =
  "Créations uniques et sur-mesure en macramé & bois flotté glané au fil des marées. Un art de vivre organique et poétique.";

const navigation = [
  ...gammes.map((gamme) => ({
    href: `/creations/${gamme.id}/`,
    texte: gamme.data.titre,
  })),
  { href: "/notre-histoire/", texte: "Notre histoire" },
  { href: "/contact/", texte: "Contact" },
];

const listeReseaux: { url: string; texte: string; icone: NomIcone }[] = [
  { ...reseaux.instagram, icone: "instagram" },
  { ...reseaux.facebook, icone: "facebook" },
  { ...reseaux.leboncoin, icone: "etiquette" },
];

const annee = new Date().getFullYear();
---

<footer class="pied">
  <div class="colonnes container">
    <div class="colonne">
      <p class="marque">MAM'CRAM</p>
      <p class="slogan">{slogan}</p>
      <p class="presentation">{presentation}</p>
      <ul class="liste">
        <li>
          <a class="lien" href={`mailto:${email}`}>
            <Icone nom="email" />
            {email}
          </a>
        </li>
        <li>
          <a class="lien" href={telephone.lien}>
            <Icone nom="telephone" />
            {telephone.affiche}
          </a>
        </li>
      </ul>
    </div>

    <nav class="colonne" aria-labelledby="titre-navigation-pied">
      <h2 id="titre-navigation-pied" class="titre">Navigation & gammes</h2>
      <ul class="liste">
        {
          navigation.map((lien) => (
            <li>
              <a class="lien" href={lien.href}>{lien.texte}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="colonne">
      <h2 class="titre">Réseaux</h2>
      <ul class="liste">
        {
          listeReseaux.map((reseau) => (
            <li>
              <a class="lien" href={reseau.url} target="_blank" rel="noopener">
                <Icone nom={reseau.icone} />
                {reseau.texte}
                <span class="visually-hidden">(nouvel onglet)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="bas container">
    <ul class="legal">
      <li><a class="lien" href="/mentions-legales/">Mentions légales</a></li>
      <li>
        <a class="lien" href="/politique-de-confidentialite/">
          Politique de confidentialité
        </a>
      </li>
    </ul>
    <p class="credits">© {annee} MAM'CRAM — Site réalisé par Julien Marchand</p>
  </div>
</footer>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .pied {
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
  }

  .colonnes {
    display: grid;
    gap: var(--espace-l);
    padding-block: var(--espace-l) var(--espace-l);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .colonne {
    display: grid;
    align-content: start;
    gap: var(--espace-s);
  }

  .marque {
    font-family: var(--font-title);
    font-size: var(--h5);
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .slogan {
    color: var(--color-accent);
    font-size: var(--little-text);
    font-weight: bold;
  }

  .presentation {
    max-width: 40ch;
    color: var(--color-text-secondary);
    font-size: var(--base-size);

    @include breakpoint-up($breakpoint-tablet) {
      max-width: 30ch;
    }
  }

  .titre {
    font-family: var(--font-text);
    font-size: var(--little-text);
    font-weight: bold;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .liste {
    list-style: none;
    display: grid;
    gap: var(--espace-s);
  }

  .lien {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-s);
    color: var(--color-text-secondary);
    font-size: var(--base-size);
    text-decoration: none;
    transition: 0.3s color ease-in-out;

    @include breakpoint-up($breakpoint-desktop) {
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  .lien :global(.icone) {
    inline-size: 1.1em;
    block-size: 1.1em;
  }

  .bas {
    display: grid;
    justify-items: center;
    gap: var(--espace-xs);
    padding-block: var(--espace-m);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .legal {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espace-s);

    .lien {
      font-size: var(--little-text);
    }

    li + li::before {
      content: "·";
      margin-inline-end: var(--espace-s);
      color: var(--color-text-secondary);
    }
  }

  .credits {
    color: var(--color-text-secondary);
    font-size: var(--little-text);
  }
</style>
