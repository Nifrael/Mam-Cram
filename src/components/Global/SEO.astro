---
import { INDEXATION } from "astro:env/server";
import { getImage } from "astro:assets";
import { nomDuSite, partageParDefaut, formatPartage } from "@/data/seo";
import { versJsonLd, type JsonLd } from "@/lib/donnees-structurees";

type Props = {
  titre: string;
  description: string;
  indexable?: boolean;
  type?: "website" | "article";
  // `string` : les photos des actualités viennent de Sanity (URL distante).
  image?: { src: ImageMetadata | string; alt: string };
  donneesStructurees?: JsonLd;
};

const {
  titre,
  description,
  indexable = true,
  type = "website",
  image = partageParDefaut,
  donneesStructurees,
} = Astro.props;

// Une page n'est indexée que si le site entier l'est ET si la page le permet.
const indexer = INDEXATION && indexable;

// Adresse officielle de la page : `site` (URL_SITE) + chemin courant. Elle dit à Google
// laquelle des adresses possibles de la page (http, www, paramètres…) il doit retenir.
const canonique = new URL(Astro.url.pathname, Astro.site);

// `getImage` produit au build le fichier recadré au format de partage.
const partage = await getImage({ src: image.src, ...formatPartage });
---

<title>{titre}</title>
<meta name="description" content={description} />
{indexable && <link rel="canonical" href={canonique} />}
{!indexer && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={nomDuSite} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:type" content={type} />
<meta property="og:title" content={titre} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonique} />
<meta property="og:image" content={new URL(partage.src, Astro.site)} />
<meta property="og:image:width" content={String(formatPartage.width)} />
<meta property="og:image:height" content={String(formatPartage.height)} />
<meta property="og:image:alt" content={image.alt} />
<meta name="twitter:card" content="summary_large_image" />
{donneesStructurees && <script type="application/ld+json" set:html={versJsonLd(donneesStructurees)} />}
