---
const liens = [
  { href: "/", texte: "Accueil" },
  { href: "/creations/", texte: "Créations" },
  { href: "/notre-histoire/", texte: "Notre histoire" },
  { href: "/actualites/", texte: "Actualités" },
  { href: "/contact/", texte: "Contact" },
];

const instagram = "https://www.instagram.com/";
---

<header>
  <div class="navbar container">
    <a class="logo" href="/">MAM'CRAM</a>

    <nav id="menu-principal" aria-label="Navigation principale">
      <ul>
        {
          liens.map((lien) => (
            <li>
              <a href={lien.href}>{lien.texte}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="reseau" href={instagram} target="_blank" rel="noopener">
      <span class="visually-hidden">Instagram (nouvel onglet)</span>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
    </a>

    <button
      type="button"
      id="bascule-menu"
      aria-controls="menu-principal"
      aria-expanded="false"
    >
      <span class="visually-hidden">Ouvrir le menu</span>
      <span class="trait" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const bascule = document.getElementById("bascule-menu");
  const menu = document.getElementById("menu-principal");

  const fermer = () => {
    bascule?.setAttribute("aria-expanded", "false");
    menu?.classList.remove("opened");
  };

  bascule?.addEventListener("click", () => {
    const ouvert = bascule.getAttribute("aria-expanded") === "true";
    bascule.setAttribute("aria-expanded", String(!ouvert));
    menu?.classList.toggle("opened", !ouvert);
  });

  document.addEventListener("keydown", (evenement) => {
    if (evenement.key === "Escape") fermer();
  });
</script>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  header {
    position: relative;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-m);
    padding-block: var(--espace-m);

    @include breakpoint-up($breakpoint-desktop) {
      padding-block: var(--espace-l);
      gap: var(--espace-l)
    }
  }

  .logo {
    font-family: var(--font-title);
    font-size: var(--h5);
    letter-spacing: 0.08em;
    color: var(--color-text);
    text-decoration: none;
    transition: 0.3s color ease-in-out;

    @include breakpoint-up($breakpoint-desktop) {
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  .reseau {
    display: flex;
    color: var(--color-text-secondary);
    margin-inline-start: auto;

    @include breakpoint-up($breakpoint-tablet) {
      margin-inline-start: 0;
    }
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;

    @include breakpoint-up($breakpoint-tablet) {
      display: none;
    }
  }

  .trait {
    position: relative;
    width: 1.25rem;
    height: 2px;
    background: var(--color-text);
    transition: background 0.2s ease;

    &::before,
    &::after {
      content: "";
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--color-text);
      transition: transform 0.2s ease;
    }

    &::before {
      transform: translateY(-0.375rem);
    }

    &::after {
      transform: translateY(0.375rem);
    }
  }


  button[aria-expanded="true"] .trait {
    background: transparent;

    &::before {
      transform: rotate(45deg);
    }

    &::after {
      transform: rotate(-45deg);
    }
  }


  nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 1;
    display: none;
    padding: var(--espace-m);
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);

    &.opened {
      display: block;
    }

    @include breakpoint-up($breakpoint-tablet) {
      position: static;
      display: block;
      padding: 0;
      border: none;
      background: none;
    }
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--espace-m);

    @include breakpoint-up($breakpoint-tablet) {
      flex-direction: row;
      gap: var(--espace-l);
    }
  }

  ul a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: 0.5s color ease-in-out;

    @include breakpoint-up($breakpoint-desktop) {
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  a:focus-visible,
  button:focus-visible {
    @include focus-visible;
  }
</style>
