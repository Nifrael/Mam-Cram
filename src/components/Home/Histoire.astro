---
import Bouton from "@/components/UI/Bouton.astro";
import { Image } from "astro:assets";
import photo from "../../assets/images/Histoire.jpg";

const surtitre = "Les mains derrière MAM'CRAM";
const titre = "Un couple de complices, un même plaisir de créer";
const paragraphes = [
  "MAM'CRAM, c'est d'abord l'histoire d'un couple qui aime faire les choses ensemble. Au fil des balades sur les grèves catalanes, nous ramassons les bois flottés qui nous font de l'œil, puis nous les ramenons à l'atelier où ils attendent leur idée.",
  "Là, à quatre mains, l'un propose une forme, l'autre imagine les nœuds, et la pièce prend vie de cet échange. Rien ne presse : nous prenons le temps d'essayer une couleur, de recommencer un nœud s'il le faut. C'est ce plaisir partagé que nous voulons glisser dans chacune de vos pièces.",
];
const citation =
  "Chaque morceau de bois flotté raconte les marées avant de trouver son fil.";
---

<!-- À VALIDER PAR LE CLIENT : histoire du couple brodée par Claude (pas de récit fourni), à faire relire -->

<section class="histoire" aria-labelledby="titre-histoire">
  <div class="contenu container">
    <figure class="visuel">
      <Image
        class="photo"
        src={photo}
        alt="Hibou en macramé couleur sable suspendu à une branche de bois flotté"
        loading="lazy"
        sizes="(min-width: 1024px) 36rem, 100vw"
      />
      <figcaption class="citation">
        <blockquote>
          <p>« {citation} »</p>
        </blockquote>
        <p class="signature">— MAM'CRAM</p>
      </figcaption>
    </figure>

    <div class="texte">
      <p class="surtitre">{surtitre}</p>
      <h2 id="titre-histoire">{titre}</h2>
      {paragraphes.map((paragraphe) => <p class="paragraphe">{paragraphe}</p>)}
      <Bouton href="/notre-histoire/" variante="secondaire">
        Lire notre histoire complète <span aria-hidden="true">→</span>
      </Bouton>
    </div>
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .histoire {
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .contenu {
    display: grid;
    gap: var(--espace-xl);
    padding-block: var(--espace-xl);

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--espace-xxl);
    }
  }

  .visuel {
    position: relative;
  }

  .photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--rayon-m);
  }

  .citation {
    position: absolute;
    inset-inline: var(--espace-m);
    bottom: calc(var(--espace-l) * -1);
    display: grid;
    gap: var(--espace-s);
    padding: var(--espace-m);
    background: var(--color-bg-cards);
    border: 1px solid var(--color-border);
    border-radius: var(--rayon-m);

    @include breakpoint-up($breakpoint-tablet) {
      inset-inline: auto calc(var(--espace-m) * -1);
      bottom: calc(var(--espace-m) * -1);
      max-width: 60%;
    }
  }

  blockquote {
    margin: 0;

    p {
      font-family: var(--font-title);
      font-style: italic;
      font-weight: bold;
    }
  }

  .signature,
  .surtitre {
    color: var(--color-accent);
    font-size: var(--little-text);
    font-weight: bold;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .texte {
    display: grid;
    gap: var(--espace-m);
    justify-items: start;
  }

  .paragraphe {
    max-width: 60ch;
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }
</style>
