---
import CarteGamme from "@/components/Home/CarteGamme.astro";
import { gammes } from "@/data/gammes";
import LienFleche from "@/components/UI/LienFleche.astro";

const surtitre = "Catalogue de l'atelier";
const titre = "Nos gammes";
const accroche =
  "Des accessoires du quotidien aux pièces architecturales, chaque création est confectionnée avec soin, nœud après nœud.";
---

<section class="gammes">
  <div class="contenu container">
    <header class="intro">
      <div class="titres">
        <p class="surtitre">{surtitre}</p>
        <h2>{titre}</h2>
        <p class="accroche">{accroche}</p>
      </div>

      <LienFleche href="/creations/">Explorer toutes les collections</LienFleche>
    </header>

    <ul class="liste">
      {
        gammes.map((gamme) => (
          <li>
            <CarteGamme gamme={gamme} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .gammes {
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .contenu {
    display: grid;
    gap: var(--espace-l);
    padding-block: var(--espace-xl);
  }

  .intro {
    display: grid;
    gap: var(--espace-m);

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: var(--espace-l);
    }
  }

  .titres {
    display: grid;
    gap: var(--espace-s);
  }

  .surtitre {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--base-size);
    letter-spacing: 0.1em;
    font-weight: bold;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
  }

  .accroche {
    margin: 0;
    max-width: 50ch;
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--espace-m);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(2, 1fr);
    }

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--espace-l);
    }
  }
</style>
