---
import type { CollectionEntry } from "astro:content";
import LienFleche from "@/components/UI/LienFleche.astro";
import CarteActualite from "@/components/Actualites/CarteActualite.astro";

type Props = { actualites: CollectionEntry<"actualites">[] };

const { actualites } = Astro.props;

const surtitre = "La vie de l'atelier";
const titre = "Dernières nouvelles";
---

<section class="actualites" aria-labelledby="titre-actualites">
  <div class="contenu container">
    <header class="entete">
      <div>
        <p class="surtitre">{surtitre}</p>
        <h2 id="titre-actualites">{titre}</h2>
      </div>
      <LienFleche href="/actualites/">Consulter toutes les actualités</LienFleche>
    </header>

    <ul class="liste">
      {
        actualites.map((actualite) => (
          <li>
            <CarteActualite actualite={actualite} niveauTitre={3} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .actualites {
    border-bottom: 1px solid var(--color-border);
  }

  .contenu {
    display: grid;
    gap: var(--espace-l);
    padding-block: var(--espace-xl);
  }

  // Titre à gauche, lien « toutes les actualités » à droite quand il y a la place.
  .entete {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--espace-s) var(--espace-l);
  }

  .surtitre {
    color: var(--color-accent);
    font-size: var(--little-text);
    font-weight: bold;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .liste {
    list-style: none;
    display: grid;
    gap: var(--espace-l);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
