---
import AppelSurMesure from "@/components/UI/AppelSurMesure.astro";
import Icone, { type NomIcone } from "@/components/UI/Icone.astro";

const surtitre = "Vos envies prennent forme";
const titre = "L'art du sur-mesure";
const accroche =
  "Vous rêvez d'une dimension exacte pour votre alcôve ou d'une nuance en harmonie avec vos textiles ? Co-créons votre pièce.";

type Atout = {
  titre: string;
  description: string;
  icone: NomIcone;
};

const atouts: Atout[] = [
  {
    titre: "Sur commande",
    description:
      "Chaque pièce est nouée à la main avec patience selon votre demande spécifique et vos délais.",
    icone: "calendrier",
  },
  {
    titre: "Personnalisation",
    description:
      "Choix des teintes de cordes, dimensions adaptées à votre intérieur et prénoms brodés ou calligraphiés.",
    icone: "palette",
  },
  {
    titre: "Pièces uniques",
    description:
      "Chaque branche de bois flotté glanée possède sa courbe singulière, rendant votre objet absolument inimitable.",
    icone: "etincelles",
  },
];
---

<section class="personnalisation" aria-labelledby="titre-personnalisation">
  <div class="contenu container">
    <header class="intro">
      <p class="surtitre">{surtitre}</p>
      <h2 id="titre-personnalisation">{titre}</h2>
      <p class="accroche">{accroche}</p>
    </header>

    <ul class="liste">
      {
        atouts.map((atout) => (
          <li class="atout">
            <span class="pastille">
              <Icone nom={atout.icone} />
            </span>

            <h3>{atout.titre}</h3>
            <p class="description">{atout.description}</p>
          </li>
        ))
      }
    </ul>

    <AppelSurMesure niveauTitre={3} />
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .personnalisation {
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .contenu {
    display: grid;
    gap: var(--espace-l);
    padding-block: var(--espace-xl);
  }

  .intro {
    display: grid;
    gap: var(--espace-s);
    justify-items: center;
    text-align: center;
  }

  .surtitre {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--base-size);
    letter-spacing: 0.1em;
    font-weight: bold;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
  }

  h3 {
    margin: 0;
    font-size: var(--h5);
  }

  .accroche {
    margin: 0;
    max-width: 55ch;
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }

  .description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--base-size);
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--espace-m);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--espace-l);
    }
  }

  .atout {
    display: grid;
    gap: var(--espace-s);
    justify-items: center;
    height: 100%;
    padding: var(--espace-l) var(--espace-m);
    background: var(--color-bg-cards);
    border: 1px solid var(--color-border);
    border-radius: var(--rayon-m);
    text-align: center;
  }

  .pastille {
    display: grid;
    place-items: center;
    inline-size: 3em;
    block-size: 3em;
    background: var(--color-accent-inversed);
    border-radius: var(--rayon-rond);
  }

  .pastille :global(.icone) {
    inline-size: 1.5em;
    block-size: 1.5em;
    color: var(--color-accent);
  }
</style>
